+            checkIfAutoSizeNeeded(mMetricsTransform.getScaledViewhostWidth(), mMetricsTransform.getScaledViewhostHeight());
+            mDocumentContext = new DocumentContext(nGetDocumentContext(getNativeHandle()));
+        }
+    }
