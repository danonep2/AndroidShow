+    public List<JSONObject> stopFrameMetricsRecording() throws JSONException {
+        mShouldRecordFrameMetrics = false;
+        List<JSONObject> result = new ArrayList<>();
+        for (FrameStat frameStat : mFrameStats) {
+            result.add(frameStat.toJSON());
+        }
+        mFrameStats.clear();
+        return result;
+    }
