-        mIsAutoSizeLayoutPending = (oldHeight != newHeight) || (oldWidth != newWidth);
-        if (mIsAutoSizeLayoutPending) {
-            Log.i(TAG, String.format("old height: %d, old width: %d, new height: %d, new width: %d, hence autoSize: %s",
