+    /**
+     * Request that the document be finished.
+     */
+    @VisibleForTesting(otherwise = VisibleForTesting.PACKAGE_PRIVATE)
+    public void finishDocument() {
+        Log.i(TAG, String.format("Document(%s) with handle(%s) finishing.", mRootConfig.getSession().getLogId(), mDocumentHandle));
+        mUserPerceivedFatalReporter.reportSuccess();
+        mFluidityIncidentReporter.emitFluidityMetrics();
+        synchronized (mLock) {
+            // mark the context as finished to block any per frame loop.
+            mIsFinished.set(true);
+            mAplClock.stop();
+
+            // Any RootContext operations need to be synchronized with the coreFrameUpdate, which
+            // currently is on Main thread.
+            // All view manipulations need to be on Main thread.
+            invokeOnMainThread(() -> {
+                // End all active events
+                cancelExecution();
+                // notify providers that rendering is finished
+                mViewPresenter.onDocumentFinish();
+            });
+            // clear all work
+            mWorkQueue.clear();
+
+            // clean up any pending events
+            mPending.clear();
+
+            // clean up Components
+            mAplComponents.clear();
+
+            //send notification to runtime
+            Viewhost viewhost = mOptions.getViewhost();
+            if (viewhost instanceof ViewhostImpl) {
+                ViewhostImpl viewhostImpl = (ViewhostImpl)viewhost;
+                if (mDocumentHandle != null) {
+                    //Triggered from unified document flow and it will finish only the document which is mapped to this rootContext.
+                    //The one usecase which still needs to be handled is to finish all embedded documents within a document that got rendered from Viewhost.java
+                    //Not finishing the embedded docs can lead to a situation where the code still exposes a handle to perform actions on embedded docs, however the main document is terminated.
+                    mDocumentHandle.setDocumentState(com.amazon.apl.viewhost.internal.DocumentState.FINISHED);
+                } else {
+                    //triggered from legacy flow. It will finish all embedded documents defined for the document.
+                    // It will end up finishing all the INFLATED document handles created by the viewhost instance.
+                    viewhostImpl.notifyRootContextFinished();
+                }
+            }
+        }
+    }
+
+    private void invokeOnMainThread(Runnable r) {
+        if (Looper.myLooper() == mMainHandler.getLooper()) {
+            r.run();
+        } else {
+            mMainHandler.post(r);
+        }
+    }
