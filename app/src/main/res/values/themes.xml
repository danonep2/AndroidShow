<resources>
    <style name="Theme.AndroidShow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.AndroidShow.Fullscreen">
        <item name="android:windowFullscreen">true</item>
    </style>
    <!-- Splash da abertura (core-splashscreen): o desenho do ícone sobre o fundo quase preto. -->
    <style name="Theme.AndroidShow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.AndroidShow</item>
    </style>
</resources>
